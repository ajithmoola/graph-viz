{
  "name": "nx-graph-viewer",
  "displayName": "NetworkX Graph Viewer",
  "description": "Interactive 3D viewer for networkx graphs exported as node-link JSON (*.graph.json)",
  "version": "0.2.0",
  "publisher": "ajithmoola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajithmoola/graph-viz.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "nxGraphViewer.view",
        "displayName": "NetworkX Graph Viewer",
        "selector": [
          {
            "filenamePattern": "*.graph.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "esbuild media/webview.js --bundle --minify --outfile=dist/webview.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.21.5",
    "three": "^0.160.1"
  }
}
